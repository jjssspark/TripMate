# TripMate 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 실제 값을 채워 넣으세요.
#   cp .env.example .env
# .env 는 .gitignore 에 등록되어 있으며 절대 커밋하지 않습니다.

# ─────────────────────────────────────────────
# 클라이언트 노출 (VITE_ 접두사 → 브라우저 번들에 그대로 포함됨)
# 여기에는 공개돼도 되는 값만 넣습니다.
# ─────────────────────────────────────────────

# Supabase 프로젝트 URL (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon public key — RLS 로 보호되는 공개 키입니다.
# service_role 키를 여기에 절대 넣지 마세요.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─────────────────────────────────────────────
# 서버 전용 (VITE_ 접두사 없음 → 브라우저에 노출되지 않음)
# Netlify 는 Dashboard → Site settings → Environment variables 에 등록합니다.
# ─────────────────────────────────────────────

# Google AI Studio 에서 발급 (https://aistudio.google.com/apikey)
# AI 일정 생성/수정에 사용됩니다.
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Console 에서 Places API 활성화 후 발급
# 일정 카드의 실제 장소 사진 조회에 사용됩니다. 비워두면 사진 없이 동작합니다.
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# ─────────────────────────────────────────────
# 로컬 개발 서버 (선택 — 기본값으로 동작합니다)
# ─────────────────────────────────────────────

# 로컬 dev 서버 포트 (기본 3000)
PORT=3000
